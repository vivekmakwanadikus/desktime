{
  "manifest_version": 3,
  "name": "DeskTime Remaining Time",
  "version": "1.1.0",
  "description": "Shows remaining productive time on DeskTime My DeskTime page.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" },
    "default_popup": "popup.html",
    "default_title": "DeskTime Remaining Time"
  },
  "content_scripts": [
    {
      "matches": ["https://desktime.com/app/*", "https://*.desktime.com/app/*"],
      "js": ["dark.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://desktime.com/app/*", "https://*.desktime.com/app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
