{
  "manifest_version": 3,
  "name": "DeskTime Remaining Time",
  "version": "1.1.0",
  "description": "Shows remaining productive time on DeskTime My DeskTime page.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeskTime Remaining Time"
  },
  "content_scripts": [
    {
      "matches": ["https://desktime.com/app/*", "https://*.desktime.com/app/*"],
      "js": ["dark.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://desktime.com/app/*", "https://*.desktime.com/app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
